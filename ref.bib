@inbook{schwarz12,
   abstract = {Feelings-as-information theory conceptualizes the role of subjective experiences-including moods, emotions, metacognitive experiences, and bodily sensations-in judgment. It assumes that people attend to their feelings as a source of information, with different feelings providing different types of information. Whereas feelings elicited by the target of judgment provide valid information, feelings that are due to an unrelated influence can lead us astray.},
